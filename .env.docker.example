# Đổi tên file thành .env.docker rồi chỉnh giá trị.
# Chạy: docker compose --env-file .env.docker up --build

JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Trình duyệt gọi API qua máy host (localhost), giữ mặc định nếu map port 3001 như trong compose
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000

# Tùy chọn (AI chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# VNPay (bắt buộc nếu dùng thanh toán VNPay)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/customer/contracts
# Tùy chọn
VNP_IPN_URL=
VNP_LOCALE=vn
VNP_CURR_CODE=VND
